{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true
	},
	"include": [
		"packages/ui/src/**/*.ts",
		"packages/ui-react/src/**/*.ts",
		"packages/ui-react/src/**/*.tsx"
	],
	"exclude": [
		"node_modules",
		"**/dist",
		"specs",
		"**/tests",
		"scripts",
		"apps",
		"examples",
		"registry"
	]
}
