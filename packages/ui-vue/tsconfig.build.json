{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": false,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["node"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
