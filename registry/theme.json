{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "type": "registry:theme",
  "title": "Roxy UI theme",
  "description": "CSS variables driving every Roxy UI component. Maps the customer's existing shadcn tokens (--card, --background, --foreground, --muted-foreground, --primary, --border, --radius) onto --roxy-* via CSS fallback chain. Override any --roxy-* directly to lock a specific surface.",
  "css": {
    "@layer base": {
      ":root": {
        "--roxy-surface": "var(--card, var(--roxy-bg))",
        "--roxy-bg": "var(--background, #ffffff)",
        "--roxy-fg": "var(--foreground, #0a0a0a)",
        "--roxy-primary": "var(--foreground, var(--roxy-fg))",
        "--roxy-secondary": "var(--muted-foreground, color-mix(in oklab, var(--roxy-fg) 78%, var(--roxy-bg)))",
        "--roxy-muted": "var(--muted-foreground, color-mix(in oklab, var(--roxy-fg) 60%, var(--roxy-bg)))",
        "--roxy-border": "var(--border, color-mix(in oklab, var(--roxy-fg) 14%, var(--roxy-bg)))",
        "--roxy-accent": "var(--primary, #4a6297)",
        "--roxy-success": "var(--chart-2, #16a34a)",
        "--roxy-warning": "var(--chart-3, #ea580c)",
        "--roxy-danger": "var(--destructive, #dc2626)",
        "--roxy-info": "var(--chart-1, #0284c7)",
        "--roxy-radius-sm": "calc(var(--radius, 6px) / 2)",
        "--roxy-radius-md": "var(--radius, 6px)",
        "--roxy-radius-lg": "calc(var(--radius, 6px) * 5 / 3)"
      }
    }
  }
}